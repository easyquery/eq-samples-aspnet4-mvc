<Project>
  <!-- Package versions for every project in this repository (NuGet central package management). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="EasyQuery and EasyData">
    <PackageVersion Include="EasyData.Exporters.ClosedXML" Version="1.6.0" />
    <PackageVersion Include="EasyData.Exporters.PdfSharp" Version="1.6.0" />
    <PackageVersion Include="Korzh.EasyQuery.AspNet4" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.DataExport" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.Db" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.EntityFramework6" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.Linq" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.MsSqlGate" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.SqlServerGate" Version="7.5.0" />
  </ItemGroup>
  <ItemGroup Label="Other packages">
    <PackageVersion Include="Antlr3.Runtime" Version="3.5.1" />
    <PackageVersion Include="EntityFramework" Version="6.2.0" />
    <PackageVersion Include="Korzh.DbUtils.Import" Version="1.4.1" />
    <PackageVersion Include="Korzh.DbUtils.SqlServer" Version="1.4.1" />
    <PackageVersion Include="Microsoft.AspNet.Identity.EntityFramework" Version="2.2.2" />
    <PackageVersion Include="Microsoft.AspNet.Identity.Owin" Version="2.2.4" />
    <PackageVersion Include="Microsoft.AspNet.Mvc" Version="5.2.7" />
    <PackageVersion Include="Microsoft.AspNet.Razor" Version="3.2.7" />
    <PackageVersion Include="Microsoft.AspNet.Web.Optimization" Version="1.1.3" />
    <PackageVersion Include="Microsoft.AspNet.WebApi.Core" Version="5.2.7" />
    <PackageVersion Include="Microsoft.AspNet.WebApi.WebHost" Version="5.2.7" />
    <PackageVersion Include="Microsoft.AspNet.WebPages" Version="3.2.7" />
    <PackageVersion Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Owin" Version="4.2.2" />
    <PackageVersion Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.2" />
    <PackageVersion Include="Microsoft.Owin.Security.Cookies" Version="4.2.2" />
    <PackageVersion Include="Microsoft.Owin.Security.Google" Version="4.2.2" />
    <PackageVersion Include="Microsoft.Owin.Security.OAuth" Version="4.2.2" />
    <PackageVersion Include="Microsoft.Web.Infrastructure" Version="1.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="Owin" Version="1.0.0" />
    <PackageVersion Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageVersion Include="System.Drawing.Common" Version="6.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
    <PackageVersion Include="WebGrease" Version="1.6.0" />
    <PackageVersion Include="X.PagedList.Mvc" Version="7.6.0" />
  </ItemGroup>
</Project>
